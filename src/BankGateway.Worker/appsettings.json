{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Outbox": {
    "PollingInterval": "00:00:01",
    "BatchSize": 20,
    "MaxAttempts": 10,
    "CleanupInterval": "01:00:00",
    "Retention": "7.00:00:00"
  },
  "Retry": {
    "InProcessAttempts": 3,
    "MaxCycles": 5,
    "Delays": ["00:00:05", "00:00:15", "00:01:00", "00:05:00", "00:15:00"]
  },
  "MockBank": {
    "Timeout": "00:00:05"
  },
  "Signing": {
    "Mode": "EphemeralSelfSigned"
  },
  "Iso20022": {
    "InitiatingPartyName": "Payment Gateway",
    "ValidateBeforeSend": true
  }
}
