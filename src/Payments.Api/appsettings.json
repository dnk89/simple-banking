{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Outbox": {
    "PollingInterval": "00:00:01",
    "BatchSize": 20,
    "MaxAttempts": 10,
    "CleanupInterval": "01:00:00",
    "Retention": "7.00:00:00"
  },
  "Idempotency": {
    "Retention": "24:00:00"
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
